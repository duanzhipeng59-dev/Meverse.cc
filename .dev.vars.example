SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
ADMIN_EMAILS=admin@example.com
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=MeVerse <verify@your-domain.com>
EPAY_API_URL=https://zpayz.cn/
EPAY_PID=your-merchant-id
EPAY_KEY=your-merchant-secret
GEMINI_CREDENTIALS_KEY=base64-encoded-32-byte-key
PUBLIC_APP_URL=https://your-production-domain.example
MYFATE_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Gemini(个人解读 single reading 固定使用;也可将 MYFATE_AI_PROVIDER 设为 gemini 全站切换)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# 中转站接入(OpenAI 兼容格式,如 api.b.ai);直连 Google 官方则删除下面两行
GEMINI_BASE_URL=https://api.b.ai
GEMINI_API_STYLE=openai
